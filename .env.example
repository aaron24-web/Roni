# Copia este archivo como `.env.local` y rellena con los valores de tu proyecto Supabase.
# Panel de Supabase → Project Settings → API

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# Conexión directa a Postgres (Settings → Database → Connection string → URI).
# Solo para tareas de desarrollo: aplicar migraciones y `npm run types:db`.
SUPABASE_DB_URL=postgresql://postgres:TU-PASSWORD@db.TU-PROYECTO.supabase.co:5432/postgres
